{
  "name": "mayoi-typescript",
  "displayName": "TypeScript and JavaScript",
  "version": "0.1.0",
  "description": "Code navigation for JavaScript, TypeScript, JSX and TSX.",
  "contributes": {
    "languages": [
      { "id": "javascriptreact", "extensions": [".jsx"], "lexer": "typescript", "lineComment": "//" },
      { "id": "typescriptreact", "extensions": [".tsx"], "lexer": "typescript", "lineComment": "//" }
    ],
    "languageServers": [
      {
        "id": "mayoi-typescript.server",
        "languages": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
        "command": "typescript-language-server",
        "args": ["--stdio"],
        "initializationOptions": { "disableAutomaticTypingAcquisition": true }
      }
    ]
  }
}
